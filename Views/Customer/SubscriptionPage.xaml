<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MilkWala.Controls"
             x:Class="MilkWala.Views.Customer.SubscriptionPage"
             BackgroundColor="#F8FAFC"
             Title="Manage Subscription">

    <Grid RowDefinitions="Auto, *">
        <controls:SyncHeaderView Grid.Row="0"/>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Status Banner -->
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Subscription Status" FontSize="12" TextColor="#64748B"/>
                            <Label Text="{Binding IsPaused, Converter={StaticResource BoolToTextConverter}, ConverterParameter='PAUSED|Active', StringFormat='Status: {0}'}"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{Binding IsPaused, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#F59E0B|#10B981'}"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="1" Text="Resume Delivery"
                                Command="{Binding ResumeDeliveryCommand}"
                                IsVisible="{Binding IsPaused}"
                                BackgroundColor="#10B981" TextColor="White" CornerRadius="8" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Milk Preference Card -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Milk Preference &amp; Daily Quantity" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>

                        <Label Text="Select Milk Type:" FontSize="13" TextColor="#475569"/>
                        <Picker ItemsSource="{Binding AvailableMilkTypes}"
                                SelectedItem="{Binding SelectedMilkType}"
                                BackgroundColor="#F1F5F9"
                                TextColor="#0F172A"
                                Title="Select Milk Type"/>

                        <Label Text="{Binding QuantityLitres, StringFormat='Daily Quantity: {0:F1} Litres'}" FontSize="13" TextColor="#475569"/>
                        <Stepper Value="{Binding QuantityLitres}" Minimum="0.5" Maximum="10.0" Increment="0.5"/>

                        <Button Text="Save Subscription"
                                Command="{Binding SaveSubscriptionCommand}"
                                BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Temporary Vacation Hold Card -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Temporary Vacation Hold" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="Pause milk deliveries while out of town." FontSize="12" TextColor="#64748B"/>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Start Date" FontSize="12" TextColor="#475569"/>
                                <DatePicker Date="{Binding VacationStartDate}" Format="dd/MM/yyyy"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="End Date" FontSize="12" TextColor="#475569"/>
                                <DatePicker Date="{Binding VacationEndDate}" Format="dd/MM/yyyy"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="Apply Vacation Hold"
                                Command="{Binding ApplyVacationHoldCommand}"
                                BackgroundColor="#F59E0B" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding StatusMessage}" TextColor="#10B981" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
