<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MilkWala.Localization"
             xmlns:controls="clr-namespace:MilkWala.Controls"
             x:Class="MilkWala.Views.Customer.SubscriptionPage"
             BackgroundColor="#F8FAFC"
             Title="{x:Static loc:Strings.ManageSubscription}">

    <Grid RowDefinitions="Auto, *">
        <controls:SyncHeaderView Grid.Row="0"/>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Status Banner -->
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{x:Static loc:Strings.SubscriptionStatus}" FontSize="12" TextColor="#64748B"/>
                            <Label Text="{Binding IsPaused, Converter={StaticResource BoolToTextConverter}, ConverterParameter={x:Static loc:Strings.BoolPausedActive}, StringFormat={x:Static loc:Strings.FmtStatus}}"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{Binding IsPaused, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#F59E0B|#10B981'}"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="1" Text="{x:Static loc:Strings.ResumeDelivery}"
                                Command="{Binding ResumeDeliveryCommand}"
                                IsVisible="{Binding IsPaused}"
                                BackgroundColor="#10B981" TextColor="White" CornerRadius="8" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Milk Preference Card -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{x:Static loc:Strings.MilkPreferenceDailyQuantity}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>

                        <Label Text="{x:Static loc:Strings.SelectMilkType}" FontSize="13" TextColor="#475569"/>
                        <Picker ItemsSource="{Binding AvailableMilkTypes}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTextConverter}}"
                                SelectedItem="{Binding SelectedMilkType}"
                                BackgroundColor="#F1F5F9"
                                TextColor="#0F172A"
                                Title="{x:Static loc:Strings.SelectMilkType2}"/>

                        <Label Text="{Binding QuantityLitres, StringFormat={x:Static loc:Strings.FmtDailyQuantity}}" FontSize="13" TextColor="#475569"/>
                        <Stepper Value="{Binding QuantityLitres}" Minimum="0.5" Maximum="10.0" Increment="0.5"/>

                        <Button Text="{x:Static loc:Strings.SaveSubscription}"
                                Command="{Binding SaveSubscriptionCommand}"
                                BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Extra milk for one day -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{x:Static loc:Strings.ExtraMilkForADay}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="{x:Static loc:Strings.GuestsOrAFestivalOrderExtra}" FontSize="12" TextColor="#64748B"/>

                        <Label Text="{x:Static loc:Strings.Day}" FontSize="12" TextColor="#475569"/>
                        <DatePicker Date="{Binding ExtraDate}" MinimumDate="{Binding ExtraMinDate}" MaximumDate="{Binding ExtraMaxDate}" Format="dd/MM/yyyy"/>

                        <Label Text="{x:Static loc:Strings.MilkType2}" FontSize="12" TextColor="#475569"/>
                        <Picker ItemsSource="{Binding AvailableMilkTypes}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTextConverter}}" SelectedItem="{Binding ExtraMilkType}" BackgroundColor="#F1F5F9" TextColor="#0F172A"/>

                        <Label Text="{Binding ExtraLitres, StringFormat={x:Static loc:Strings.FmtExtraQuantity}}" FontSize="12" TextColor="#475569"/>
                        <Stepper Value="{Binding ExtraLitres}" Minimum="0.5" Maximum="10.0" Increment="0.5"/>

                        <Entry Text="{Binding ExtraInstruction}" Placeholder="{x:Static loc:Strings.NoteForTheDeliveryPersonOptional}" BackgroundColor="#F8FAFC" TextColor="#0F172A"/>

                        <Button Text="{x:Static loc:Strings.OrderExtraMilk}" Command="{Binding RequestExtraMilkCommand}"
                                BackgroundColor="#8B5CF6" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44"/>

                        <Label Text="{x:Static loc:Strings.YourUpcomingExtraOrders}" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" Margin="0,6,0,0"/>
                        <CollectionView ItemsSource="{Binding UpcomingExtras}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding TargetDate, StringFormat='{0:ddd, dd MMM yyyy}'}" FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                                            <Label FontSize="12" TextColor="#64748B">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{x:Static loc:Strings.FmtLitresMilk}">
                                                        <Binding Path="ExtraQuantityLitres"/>
                                                        <Binding Path="MilkType" Converter="{StaticResource EnumTextConverter}"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="{x:Static loc:Strings.Cancel}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelExtraOrderCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#EF4444" TextColor="White" FontSize="11" CornerRadius="8" HeightRequest="34"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Temporary Vacation Hold Card -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{x:Static loc:Strings.TemporaryVacationHold}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="{x:Static loc:Strings.PauseMilkDeliveriesWhileOutOf}" FontSize="12" TextColor="#64748B"/>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{x:Static loc:Strings.StartDate}" FontSize="12" TextColor="#475569"/>
                                <DatePicker Date="{Binding VacationStartDate}" Format="dd/MM/yyyy"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{x:Static loc:Strings.EndDate}" FontSize="12" TextColor="#475569"/>
                                <DatePicker Date="{Binding VacationEndDate}" Format="dd/MM/yyyy"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="{x:Static loc:Strings.ApplyVacationHold}"
                                Command="{Binding ApplyVacationHoldCommand}"
                                BackgroundColor="#F59E0B" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>


            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
