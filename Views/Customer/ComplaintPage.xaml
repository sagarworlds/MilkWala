<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MilkWala.Localization"
             xmlns:controls="clr-namespace:MilkWala.Controls"
             x:Class="MilkWala.Views.Customer.ComplaintPage"
             BackgroundColor="#F8FAFC"
             Title="{x:Static loc:Strings.Complaints}">

    <Grid RowDefinitions="Auto, *">
        <controls:SyncHeaderView Grid.Row="0"/>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- New Complaint Form -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{x:Static loc:Strings.RaiseATicketComplaint}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>

                        <Label Text="{x:Static loc:Strings.Category}" FontSize="12" TextColor="#475569"/>
                        <Picker ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTextConverter}}" SelectedItem="{Binding SelectedCategory}" BackgroundColor="#F1F5F9" TextColor="#0F172A"/>

                        <Entry Text="{Binding Subject}" Placeholder="{x:Static loc:Strings.SubjectBriefSummary}" BackgroundColor="#F8FAFC" TextColor="#0F172A"/>
                        <Editor Text="{Binding Description}" Placeholder="{x:Static loc:Strings.DetailedDescription}" HeightRequest="80" BackgroundColor="#F8FAFC" TextColor="#0F172A"/>

                        <Button Text="{x:Static loc:Strings.SubmitTicket}" Command="{Binding SubmitComplaintCommand}" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Complaints History List -->
                <Label Text="{x:Static loc:Strings.MySupportTickets}" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,8,0,0"/>

                <CollectionView ItemsSource="{Binding Complaints}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#E2E8F0" Padding="12" Margin="0,4">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="{Binding Subject}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Padding="6,2" BackgroundColor="#3B82F6">
                                            <Label Text="{Binding Status, Converter={StaticResource EnumTextConverter}}" FontSize="11" TextColor="White" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding Description}" FontSize="12" TextColor="#475569"/>
                                    <Label Text="{Binding CreatedAt, StringFormat={x:Static loc:Strings.FmtRaisedOn}}" FontSize="11" TextColor="#94A3B8"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
