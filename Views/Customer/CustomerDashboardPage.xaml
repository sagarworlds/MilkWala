<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MilkWala.Controls"
             x:Class="MilkWala.Views.Customer.CustomerDashboardPage"
             BackgroundColor="#F8FAFC"
             Title="Customer Dashboard">

    <Grid RowDefinitions="Auto, *">
        <controls:SyncHeaderView Grid.Row="0"/>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Customer Welcome & Wallet Card -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="#0F172A"
                        Padding="20"
                        StrokeThickness="0">
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="Welcome back," FontSize="13" TextColor="#94A3B8"/>
                            <Label Text="{Binding CurrentCustomer.Name}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="{Binding CurrentCustomer.Address}" FontSize="11" TextColor="#CBD5E1" MaxLines="1"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="End" Spacing="2">
                            <Label Text="Wallet Balance" FontSize="11" TextColor="#94A3B8" HorizontalOptions="End"/>
                            <Label Text="{Binding WalletBalance, Converter={StaticResource CurrencyFormatConverter}}"
                                   FontSize="20" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Today's Delivery Card -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Today's Milk Delivery" FontSize="16" FontAttributes="Bold" TextColor="#1E293B"/>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="8,4"
                                    BackgroundColor="{Binding TodaysDelivery.Status, Converter={StaticResource StatusToColorConverter}}">
                                <Label Text="{Binding TodaysDelivery.Status}" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9"/>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="8">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Milk Type" FontSize="11" TextColor="#64748B"/>
                                <Label Text="{Binding TodaysDelivery.MilkType}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Quantity" FontSize="11" TextColor="#64748B"/>
                                <Label Text="{Binding TodaysDelivery.QuantityLitres, StringFormat='{0} Litres'}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Rate / Litre" FontSize="11" TextColor="#64748B"/>
                                <Label Text="{Binding TodaysDelivery.RatePerLitre, Converter={StaticResource CurrencyFormatConverter}}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Total Amount" FontSize="11" TextColor="#64748B"/>
                                <Label Text="{Binding TodaysDelivery.TotalPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="14" FontAttributes="Bold" TextColor="#0EA5E9"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Monthly Summary Stats Grid -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Monthly Milk" FontSize="12" TextColor="#64748B"/>
                            <Label Text="{Binding MonthlyLitresDelivered, StringFormat='{0:F1} Litres'}" FontSize="18" FontAttributes="Bold" TextColor="#0EA5E9"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Monthly Total" FontSize="12" TextColor="#64748B"/>
                            <Label Text="{Binding MonthlyTotalAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="18" FontAttributes="Bold" TextColor="#8B5CF6"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Recent Deliveries List -->
                <Label Text="Recent Deliveries" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,8,0,0"/>

                <CollectionView ItemsSource="{Binding RecentDeliveries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#E2E8F0" Padding="12" Margin="0,4">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" WidthRequest="40" HeightRequest="40"
                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" Margin="0,0,12,0">
                                        <Label Text="✓" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding DeliveryDate, StringFormat='{0:dd MMM yyyy}'}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                        <Label Text="{Binding MilkType, StringFormat='{0} Milk'}" FontSize="12" TextColor="#64748B"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding QuantityLitres, StringFormat='{0} L'}" FontSize="14" FontAttributes="Bold" TextColor="#0EA5E9" HorizontalOptions="End"/>
                                        <Label Text="{Binding TotalPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="12" TextColor="#64748B" HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
