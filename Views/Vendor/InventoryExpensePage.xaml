<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MilkWala.Controls"
             x:Class="MilkWala.Views.Vendor.InventoryExpensePage"
             BackgroundColor="#F8FAFC"
             Title="Inventory &amp; Expenses">

    <Grid RowDefinitions="Auto, *">
        <controls:SyncHeaderView Grid.Row="0"/>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Stock Overview Grid -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="#0F172A" Padding="16" StrokeThickness="0">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Today's Milk Stock Balance" FontSize="16" FontAttributes="Bold" TextColor="White"/>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Morning" FontSize="10" TextColor="#94A3B8"/>
                                <Label Text="{Binding MorningStock, StringFormat='{0} L'}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Evening" FontSize="10" TextColor="#94A3B8"/>
                                <Label Text="{Binding EveningStock, StringFormat='{0} L'}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="Dispatched" FontSize="10" TextColor="#94A3B8"/>
                                <Label Text="{Binding DistributedStock, StringFormat='{0} L'}" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="3">
                                <Label Text="Remaining" FontSize="10" TextColor="#94A3B8"/>
                                <Label Text="{Binding RemainingStock, StringFormat='{0} L'}" FontSize="13" FontAttributes="Bold" TextColor="#10B981"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Log Expense Form -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Log Business Expense" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>

                        <Label Text="Expense Category:" FontSize="12" TextColor="#475569"/>
                        <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BackgroundColor="#F1F5F9" TextColor="#0F172A"/>

                        <Entry Text="{Binding ExpenseAmount}" Placeholder="Amount (₹)" Keyboard="Numeric" BackgroundColor="#F8FAFC" TextColor="#0F172A"/>
                        <Entry Text="{Binding ExpenseDescription}" Placeholder="Notes / Vendor / Fuel Bill No." BackgroundColor="#F8FAFC" TextColor="#0F172A"/>

                        <Button Text="Record Expense" Command="{Binding AddExpenseCommand}" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Expense History -->
                <Label Text="Recent Expenses" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,8,0,0"/>

                <CollectionView ItemsSource="{Binding Expenses}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#E2E8F0" Padding="12" Margin="0,4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Category}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="#64748B"/>
                                        <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}" FontSize="11" TextColor="#94A3B8"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="15" FontAttributes="Bold" TextColor="#EF4444" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
