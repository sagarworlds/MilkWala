<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MilkWala.Localization"
             xmlns:controls="clr-namespace:MilkWala.Controls"
             x:Class="MilkWala.Views.Vendor.DeliveryManagementPage"
             BackgroundColor="#F8FAFC"
             Title="{x:Static loc:Strings.DeliveryManagement}">

    <Grid RowDefinitions="Auto, *">
        <controls:SyncHeaderView Grid.Row="0"/>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <Label Text="{x:Static loc:Strings.TodaySDeliveryChecklist}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>

                <CollectionView ItemsSource="{Binding Deliveries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16" Margin="0,4">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding CustomerName}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>
                                            <Label Text="{Binding Address}" FontSize="12" TextColor="#64748B"/>
                                            <Label Text="{Binding Notes}" FontSize="12" TextColor="#8B5CF6" FontAttributes="Bold"
                                                   IsVisible="{Binding Notes, Converter={StaticResource StringHasTextConverter}}"/>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="8,4"
                                                BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                            <Label Text="{Binding Status, Converter={StaticResource EnumTextConverter}}" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>

                                    <Label FontSize="13" TextColor="#0EA5E9" FontAttributes="Bold">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{x:Static loc:Strings.FmtRequiredLitres}">
                                                <Binding Path="QuantityLitres"/>
                                                <Binding Path="MilkType" Converter="{StaticResource EnumTextConverter}"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>

                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                        <Button Grid.Column="0" Text="{x:Static loc:Strings.MarkDelivered}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkDeliveredCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#10B981" TextColor="White" CornerRadius="8" HeightRequest="40"/>

                                        <Button Grid.Column="1" Text="{x:Static loc:Strings.MarkSkipped}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkSkippedCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F59E0B" TextColor="White" CornerRadius="8" HeightRequest="40"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
