<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MilkWala.Controls"
             x:Class="MilkWala.Views.Vendor.BackupPage"
             BackgroundColor="#F8FAFC"
             Title="Backup &amp; Restore">

    <Grid RowDefinitions="Auto, *">
        <controls:SyncHeaderView Grid.Row="0"/>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Back up your data" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="Saves customers, deliveries, payments and everything else on this phone. Share the backup to keep a copy somewhere safe."
                               FontSize="12" TextColor="#64748B"/>
                        <Button Text="Create backup now" Command="{Binding CreateBackupCommand}"
                                BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Backups on this phone" FontSize="16" FontAttributes="Bold" TextColor="#1E293B"/>
                <Label Text="No backups yet." FontSize="12" TextColor="#94A3B8"
                       IsVisible="{Binding HasBackups, Converter={StaticResource InverseBoolConverter}}"/>

                <CollectionView ItemsSource="{Binding BackupFiles}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#E2E8F0" Padding="12" Margin="0,4">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy, hh:mm tt}'}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <Label FontSize="11" TextColor="#94A3B8">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} • {1}">
                                                <Binding Path="Name"/>
                                                <Binding Path="SizeText"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                        <Button Grid.Column="0" Text="Share"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShareBackupCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#6B7280" TextColor="White" CornerRadius="8" HeightRequest="40"/>
                                        <!-- Restore asks for confirmation first, so it is handled in the page code-behind. -->
                                        <Button Grid.Column="1" Text="Restore" Clicked="OnRestoreClicked"
                                                BackgroundColor="#EF4444" TextColor="White" CornerRadius="8" HeightRequest="40"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
